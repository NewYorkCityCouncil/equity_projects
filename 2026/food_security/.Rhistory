cfc = readRDS("~/Documents/GitHub/food_insecurity/data/output/cfc_geocoded_2024.RDS") %>%
st_as_sf() %>%
mutate(Name = tolower(PROGRAM)) %>%
clean_names()
all_pantries = st_read("/Users/ADriscoll/Documents/GitHub/Emergency-Food-Access-Index/FP_data/food_pantry_schedule.geojson") %>%
mutate(Name = tolower(Name)) %>%
clean_names()
closest = st_nearest_feature(cfc, all_pantries)
distances = st_distance(cfc, all_pantries[closest, ], by_element = TRUE) %>% as.numeric()
cfc = cfc %>%
mutate(dist_match = distances,
name_match = all_pantries$Name[closest],
text_match = stringsim(Name, name_match))
View(cfc %>% select(Name, name_match, text_match, dist_match))
clean_names = function(df, replace = "inc|the|for|,|corps|corporation|\\.|soup kitchen|food pantry|pantry|&|-|of|'s|\\.|+|-|'|,|/|!") {
df = df %>%
mutate(Name = tolower(Name),
Name = gsub(replace, "", Name),
Name = str_squish(Name),
Name = gsub("catholic charities community services", "cccs", Name),
Name = gsub("seventh day adventist", "sda", Name),
Name = gsub("muslim ummah north america", "muna", Name),
Name = gsub("pakistani american youth organization", "payo", Name),
Name = gsub("or people in need", "opin", Name),
#Name = gsub("s+", " ", Name),
Name = str_squish(Name))
return(df)
}
cfc = readRDS("~/Documents/GitHub/food_insecurity/data/output/cfc_geocoded_2024.RDS") %>%
st_as_sf() %>%
mutate(Name = tolower(PROGRAM)) %>%
clean_names()
all_pantries = st_read("/Users/ADriscoll/Documents/GitHub/Emergency-Food-Access-Index/FP_data/food_pantry_schedule.geojson") %>%
mutate(Name = tolower(Name)) %>%
clean_names()
closest = st_nearest_feature(cfc, all_pantries)
distances = st_distance(cfc, all_pantries[closest, ], by_element = TRUE) %>% as.numeric()
cfc = cfc %>%
mutate(dist_match = distances,
name_match = all_pantries$Name[closest],
text_match = stringsim(Name, name_match))
View(cfc %>% select(Name, name_match, text_match, dist_match))
cfc = cfc %>% mutate(match = text_match > .4 | dist_match < .2)
View(cfc %>% select(Name, name_match, text_match, dist_match, match))
